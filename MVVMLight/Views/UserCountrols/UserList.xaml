<UserControl x:Class="MVVMLight.Views.UserCountrols.UserList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVMLight.Views.UserCountrols"
             xmlns:uc="clr-namespace:MVVMLigtDemo.UserControls"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询条件">
            <WrapPanel VerticalAlignment="Center">
                <Label Content="账号:" Foreground="White" />
                <TextBox
                    Width="120"
                    Height="30"
                    Margin="10,0"
                    Text="{Binding Account}" />
                <Button
                    Width="80"
                    Height="30"
                    Margin="10,0"
                    Command="{Binding SearchCommand}"
                    CommandParameter="0"
                    Content="查询" />


                <Button
                    Width="80"
                    Height="30"
                    Command="{Binding AddEditCommand}"
                    CommandParameter="0"
                    Content="添加" />
                <Button
                    Width="80"
                    Height="30"
                    Command="{Binding SendCommand}"
                    CommandParameter="吴亦凡"
                    Content="发送消息" />
            </WrapPanel>


        </GroupBox>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding Users}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="编号">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UserId}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Width="*" Header="账号">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Account}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="密码">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Password}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Width="*" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Button Command="{Binding DataContext.AddEditCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" CommandParameter="{Binding UserId}">修改</Button>
                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" CommandParameter="{Binding UserId}">删除</Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>





        <uc:UCPage Grid.Row="2" 
                   x:Name="ucPage1">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PageChanged">
                    <i:InvokeCommandAction Command="{Binding PageChangeCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </uc:UCPage>



    </Grid>

</UserControl>
