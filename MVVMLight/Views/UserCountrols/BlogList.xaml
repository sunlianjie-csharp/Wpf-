<UserControl x:Class="MVVMLight.Views.UserCountrols.BlogList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVMLight.Views.UserCountrols"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding Source={StaticResource Locator},Path=Login}">
    <Grid>
        <StackPanel>
            <Button Content="注册消息" Width="100" Height="30" Command="{Binding RegisterCommand}"></Button>
            <Button Content="清除注册" Width="100" Height="30" Command="{}"></Button>
        </StackPanel>
    </Grid>
</UserControl>
