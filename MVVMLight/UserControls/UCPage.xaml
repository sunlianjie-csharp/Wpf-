<UserControl x:Class="MVVMLigtDemo.UserControls.UCPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVMLigtDemo.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <WrapPanel VerticalAlignment="Center">
            <Button
         Name="btnFirst"
         Width="80"
         Height="30"
         Click="btnFirst_Click"
         Content="首页" />
            <Button
         Name="btnPrev"
         Width="80"
         Height="30"
         Margin="10,0,0,0"
         Click="btnPrev_Click"
         Content="前一页" />

            <TextBlock
         Name="tbPageAndTotalPage"
         Margin="10,0"
         VerticalAlignment="Center"
         Text="1/100" />

            <Button
         Name="btnNext"
         Width="80"
         Height="30"
         Click="btnNext_Click"
         Content="后一页" />
            <Button
         Name="btnLast"
         Width="80"
         Height="30"
         Margin="10,0,0,0"
         Click="btnLast_Click"
         Content="末页" />

            <TextBlock
         Margin="10,0,0,0"
         VerticalAlignment="Center"
         Text="条数：" />
            <ComboBox
         Name="cbbPageSize"
         Width="60"
         VerticalContentAlignment="Center"
         SelectionChanged="cbbPageSize_SelectionChanged">
                <ComboBoxItem Content="10" />
                <ComboBoxItem Content="20" />
                <ComboBoxItem Content="30" />
                <ComboBoxItem Content="40" />
                <ComboBoxItem Content="50" />
            </ComboBox>

            <TextBlock
         Margin="10,0,0,0"
         VerticalAlignment="Center"
         Text="页码：" />
            <TextBox
         Name="txtPage"
         Width="80"
         HorizontalContentAlignment="Center"
         VerticalContentAlignment="Center"
         PreviewTextInput="txtPage_PreviewTextInput" />
            <Button
         Name="btnGo"
         Width="80"
         Height="30"
         Margin="10,0"
         Click="btnGo_Click"
         Content="跳转" />
        </WrapPanel>
    </Grid>
</UserControl>
