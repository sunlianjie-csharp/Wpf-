<Window x:Class="templatePack空白项目.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:templatePack空白项目.Views"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="textBox" HorizontalAlignment="Left" Margin="166,173,0,0" 
                 TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"
                 Text="{Binding Users.Name}"
                 
                 />
        <TextBox x:Name="textBox1" HorizontalAlignment="Left" Margin="166,217,0,0" 
                 TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                     Text="{Binding Users.Pass}"
                 />

        <Label x:Name="label" Content="用户名" HorizontalAlignment="Left" Margin="107,169,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label1" Content="密码" HorizontalAlignment="Left" Margin="107,213,0,0" VerticalAlignment="Top"/>
        <Button x:Name="button" Content="登录" HorizontalAlignment="Left" Margin="191,276,0,0" VerticalAlignment="Top"
                Command="{Binding LoginCommand}"
                />

    </Grid>
</Window>
