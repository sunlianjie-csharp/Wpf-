<Window x:Class="原生成器.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:原生成器"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="{Binding Name}" Width="100" Height="100"></TextBlock>
        <Button Height="100" Width="100" Command="{Binding FirstCommand}" Margin="18,18"></Button>
        <Button Height="100" Width="100" Command="{Binding SecondCommand}" Margin="508,167,192,168" CommandParameter="1"></Button>
    </Grid>
</Window>
