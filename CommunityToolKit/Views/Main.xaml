<Window x:Class="CommunityToolKit.Views.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityToolKit.Views"
        mc:Ignorable="d"
        Title="Main" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBox  Text="{Binding Name}" Width="100" Height="30"></TextBox>
            <TextBox  Text="{Binding Type}" Width="100" Height="30"></TextBox>
            <TextBlock Text="{Binding Name}" Width="100" Height="30"></TextBlock>
            <TextBlock Text="{Binding Type}" Width="100" Height="30"></TextBlock>
            <Button Command="{Binding FirstCommand}" Content="不带参数" ></Button>
            <Button Command="{Binding SecondCommand}" Content="带参数"  CommandParameter="李易峰"></Button>
            <Button Command="{Binding ThridCommand}" Content="带参数异步指令"  CommandParameter="李易峰1"></Button>
            <Button Command="{Binding OpemCommand}" Content="打开窗体" ></Button>
            <Button Command="{Binding SendCommand}" Content="发送消息" ></Button>

            <DataGrid ItemsSource="{Binding Users}"></DataGrid>
        </StackPanel>
    </Grid>
</Window>
